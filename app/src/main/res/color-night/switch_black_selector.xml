<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 夜间开启态：带点灰（引用专用色 switch_on_night，用户后续手动微调） -->
    <item android:state_checked="true" android:color="@color/switch_on_night" />
    <!-- 夜间关闭态：浅灰，在暗底上仍可见（引用专用色 switch_off_night） -->
    <item android:state_checked="false" android:color="@color/switch_off_night" />
</selector>
