<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <!-- 状态栏占位条：页面背景底色，高度由 Activity 按真实状态栏高度设置，与标题栏连成整体覆盖状态栏 -->
    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <!-- 标题栏：黑底，紧跟占位条之下，标题文字在状态栏下方完整显示 -->
    <LinearLayout android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">

        <ImageView android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/cp_title"
            android:padding="14dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="返回"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="调试"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/cp_title" />

            <TextView android:id="@+id/tv_title_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/cp_hint_dark" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="版本："
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="作者："
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:text="    初心丶CX、乘舟待屿、兰源、NaHCO3、远否"
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="角色："
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:text="    崩铁-刃-芝麻酥"
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="感谢："
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="    芝麻酥促销(半江离)、Shimeji(kilkakon)"
                android:textSize="16dp" />

            <!-- ===== 夜间模式强制开关 ===== -->
            <TextView
                style="@style/SettingsOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="显示" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="强制打开夜间模式" />

                <Switch
                    android:id="@+id/sw_force_night_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="强制关闭夜间模式" />

                <Switch
                    android:id="@+id/sw_force_night_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>
            <!-- ===== 静态边界（定格/食物绝对显示边界，仅钳竖向，范围 -200~400） ===== -->
            <TextView
                style="@style/SettingsOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="静态边界（定格/食物显示范围）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="静态顶部边界（默认120，范围-200~400）" />

                <EditText
                    android:id="@+id/tv_static_top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned"
                    android:minWidth="56dp"
                    android:text="120"
                    android:textColor="@color/cp_title"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_static_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="600"
                android:progress="320" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="静态底部边界（默认0，范围-200~400）" />

                <EditText
                    android:id="@+id/tv_static_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned"
                    android:minWidth="56dp"
                    android:text="0"
                    android:textColor="@color/cp_title"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_static_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="600"
                android:progress="200" />
            <!-- ===== 数量（实验性，多实例分身） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="数量（实验性）" />

                <TextView
                    android:id="@+id/tv_pet_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/cp_title"
                    android:textSize="16dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_pet_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="20"
                android:progress="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="仅单个碎碎念" />

                <Switch
                    android:id="@+id/sw_single_tray_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <!-- ===== 调试（页尾） ===== -->
            <TextView
                style="@style/SettingsOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="调试" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="诊断：隐藏控制层(仅画布)" />

                <Switch
                    android:id="@+id/sw_hide_control_layer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="诊断：隐藏画布(仅控制窗)" />

                <Switch
                    android:id="@+id/sw_hide_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="左下调试信息" />

                <Switch
                    android:id="@+id/sw_debug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示边界偏移线" />

                <Switch
                    android:id="@+id/sw_bound_offset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示吸附边界" />

                <Switch
                    android:id="@+id/sw_snap_offset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示边框(图片窗口+锚点十字)" />

                <Switch
                    android:id="@+id/sw_image_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="控制边框(命中可视化)" />

                <Switch
                    android:id="@+id/sw_control_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示定格边框（红色真实窗口）" />

                <Switch
                    android:id="@+id/sw_freeze_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示投喂边框（红色真实窗口）" />

                <Switch
                    android:id="@+id/sw_feed_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="强制显示无透明（去掉点击穿透）" />

                <Switch
                    android:id="@+id/sw_force_opaque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
            </LinearLayout>
            <!-- ===== 命中模式（三态单选） ===== -->
            <TextView
                style="@style/SettingsOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="命中模式" />

            <RadioGroup
                android:id="@+id/rg_hit_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_hit_pixel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="像素（全框 + 透明穿透）" />

                <RadioButton
                    android:id="@+id/rb_hit_boundary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="边界（原矩形命中 · 全框整窗）" />

                <RadioButton
                    android:id="@+id/rb_hit_core"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="核心（脚底盒）" />
            </RadioGroup>
            <!-- 核心(脚底盒)命中区尺寸（128 逻辑基数，应用层 ×scale 转像素） -->
            <LinearLayout
                android:id="@+id/row_ctrl_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsOptionSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="核心宽度（相对128基准尺寸，默认80）" />

                    <EditText
                        android:id="@+id/tv_ctrl_box_w"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minWidth="56dp"
                        android:text="80"
                        android:textColor="@color/cp_title"
                        android:textSize="16dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_ctrl_box_w"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="256"
                    android:progress="80" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsOptionSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="核心高度（相对128基准尺寸，默认80）" />

                    <EditText
                        android:id="@+id/tv_ctrl_box_h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minWidth="56dp"
                        android:text="80"
                        android:textColor="@color/cp_title"
                        android:textSize="16dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_ctrl_box_h"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="256"
                    android:progress="80" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsOptionSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="核心垂直偏移（相对128基准尺寸，默认0）" />

                    <EditText
                        android:id="@+id/tv_ctrl_box_vo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:imeOptions="actionDone"
                        android:inputType="numberSigned"
                        android:minWidth="56dp"
                        android:text="0"
                        android:textColor="@color/cp_title"
                        android:textSize="16dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_ctrl_box_vo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="256"
                    android:progress="128" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_pixel_hit_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/SettingsOptionSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="像素级点击测试" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text=">"
                    android:textColor="@color/cp_hint_dark"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- ===== 无障碍权限（页面最末） ===== -->
            <TextView
                android:id="@+id/tv_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="无障碍权限：未开启"
                android:textSize="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
