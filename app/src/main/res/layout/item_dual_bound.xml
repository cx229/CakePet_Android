<?xml version="1.0" encoding="utf-8"?>
<!-- 双滑块类阈值项（如随机周期、空白时长）：统一为「下界 ≤ 左值默认 ≤ 右值默认 ≤ 上界」四个输入框，
     与单滑块阈值项样式一致；下界同时约束 A/B 两组下限，上界同时约束 A/B 两组上限。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
    android:layout_marginTop="0dp" android:layout_marginBottom="12dp">

    <TextView android:id="@+id/tv_label"
        style="@style/SettingsOptionTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="0dp">

        <!-- 下界：上输入框 / 下“下界” -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <EditText android:id="@+id/et_min"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:inputType="numberDecimal" android:textSize="13sp" android:gravity="center"
                android:background="@drawable/edit_bg"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="下界" android:textSize="11sp" android:textColor="@color/cp_note"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ≤ ：上“≤” / 下空白占位 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="≤" android:textSize="13sp" android:textColor="@color/cp_note"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" " android:textSize="11sp"/>
        </LinearLayout>

        <!-- 左值默认：上输入框 / 下“左值默认” -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <EditText android:id="@+id/et_def_a"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:inputType="numberDecimal" android:textSize="13sp" android:gravity="center"
                android:background="@drawable/edit_bg"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="左值默认" android:textSize="11sp" android:textColor="@color/cp_note"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ≤ ：上“≤” / 下空白占位 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="≤" android:textSize="13sp" android:textColor="@color/cp_note"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" " android:textSize="11sp"/>
        </LinearLayout>

        <!-- 右值默认：上输入框 / 下“右值默认” -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <EditText android:id="@+id/et_def_b"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:inputType="numberDecimal" android:textSize="13sp" android:gravity="center"
                android:background="@drawable/edit_bg"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="右值默认" android:textSize="11sp" android:textColor="@color/cp_note"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ≤ ：上“≤” / 下空白占位 -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="≤" android:textSize="13sp" android:textColor="@color/cp_note"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" " android:textSize="11sp"/>
        </LinearLayout>

        <!-- 上界：上输入框 / 下“上界” -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <EditText android:id="@+id/et_max"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:inputType="numberDecimal" android:textSize="13sp" android:gravity="center"
                android:background="@drawable/edit_bg"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="上界" android:textSize="11sp" android:textColor="@color/cp_note"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
