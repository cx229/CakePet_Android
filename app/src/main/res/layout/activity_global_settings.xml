<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg">

    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">
        <ImageView android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/cp_title"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cp_title" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:id="@+id/row_import_watermark" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginTop="0dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="素材处理" android:textSize="14sp" android:textColor="@color/cp_sub"
        android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:divider="@drawable/item_divider" android:showDividers="middle"
        android:dividerPadding="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <com.cx.cakepet.SettingsRippleRow android:id="@+id/row_watermark_toggle"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="自动去水印"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导入素材时尝试清理边角疑似水印"/>
</LinearLayout>
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_import_watermark"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:minWidth="0dp" android:minHeight="0dp"
    android:thumbTint="@color/switch_black_selector"
    android:trackTint="@color/switch_black_selector"/>
</com.cx.cakepet.SettingsRippleRow><LinearLayout android:id="@+id/row_import_watermark_level"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="去水印强度"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="强度越高，处理范围越大，也越可能影响素材"/>
    <RadioGroup android:id="@+id/rg_import_watermark_level" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/rb_watermark_low" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="低"
            android:textColor="@color/cp_title"/>
        <RadioButton android:id="@+id/rb_watermark_medium" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="中"
            android:textColor="@color/cp_title"/>
        <RadioButton android:id="@+id/rb_watermark_high" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="高"
            android:textColor="@color/cp_title"/>
    </RadioGroup>
</LinearLayout>
    </LinearLayout>
</LinearLayout>
            <LinearLayout android:id="@+id/backup_group" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout  android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginTop="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="个性化" android:textSize="14sp" android:textColor="@color/cp_sub"
        android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:divider="@drawable/item_divider" android:showDividers="middle"
        android:dividerPadding="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <com.cx.cakepet.SettingsRippleRow android:id="@+id/row_user_habits"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="用户习惯"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="新角色的设置与默认值"/>
</LinearLayout>
    <ImageView android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right" app:tint="@color/icon_chevron"
        android:layout_marginStart="12dp"
        android:clickable="false" android:focusable="false"/>
</com.cx.cakepet.SettingsRippleRow>
    </LinearLayout>
</LinearLayout>
                <LinearLayout  android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginTop="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="数据与备份" android:textSize="14sp" android:textColor="@color/cp_sub"
        android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:divider="@drawable/item_divider" android:showDividers="middle"
        android:dividerPadding="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <com.cx.cakepet.SettingsRippleRow android:id="@+id/row_backup_export"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="导出软件备份"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="将软件设置与数据保存为备份文件"/>
</LinearLayout>
    <ImageView android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right" app:tint="@color/icon_chevron"
        android:layout_marginStart="12dp"
        android:clickable="false" android:focusable="false"/>
</com.cx.cakepet.SettingsRippleRow><com.cx.cakepet.SettingsRippleRow android:id="@+id/row_backup_import"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="导入软件备份"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="从备份文件恢复软件设置与数据"/>
</LinearLayout>
    <ImageView android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right" app:tint="@color/icon_chevron"
        android:layout_marginStart="12dp"
        android:clickable="false" android:focusable="false"/>
</com.cx.cakepet.SettingsRippleRow>
    </LinearLayout>
</LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/system_section_container" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="24dp">
    <TextView android:id="@+id/system_section_heading"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="系统与调试" android:textSize="14sp" android:textColor="@color/cp_sub"
        android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:id="@+id/system_group" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/card_bg" android:divider="@drawable/item_divider"
        android:showDividers="middle" android:dividerPadding="16dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">
        <com.cx.cakepet.SettingsRippleRow android:id="@+id/row_accessibility"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:paddingStart="20dp"
    android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="无障碍权限"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="查看与管理无障碍权限"/>
</LinearLayout>
    <TextView android:id="@+id/tv_accessibility_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="未开启" android:textSize="14sp"
        android:textColor="@color/cp_note"/>
    <ImageView android:layout_width="22dp" android:layout_height="22dp"
        android:layout_marginStart="12dp" android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron" android:clickable="false"
        android:focusable="false" android:contentDescription="前往设置"/>
</com.cx.cakepet.SettingsRippleRow>
        <com.cx.cakepet.SettingsRippleRow android:id="@+id/row_next"
    style="@style/SettingsSwitchRow"
    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout style="@style/SettingsSwitchTexts">
    <TextView style="@style/SettingsOptionTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:id="@+id/tv_next" android:text="调试"/>
    <TextView style="@style/SettingsOptionNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="测试与排查软件运行问题"/>
</LinearLayout>
    <ImageView android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right" app:tint="@color/icon_chevron"
        android:layout_marginStart="12dp"
        android:clickable="false" android:focusable="false"/>
</com.cx.cakepet.SettingsRippleRow>
    </LinearLayout>
</LinearLayout>
            <LinearLayout android:id="@+id/test_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/btn_create_test"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/cp_btn_primary_text"
                    android:textSize="14sp"
                    android:text="实验 C：全屏画布 + 独立控制窗口" />
                <TextView android:id="@+id/btn_passive_test"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/cp_btn_primary_text"
                    android:textSize="14sp"
                    android:text="实验 A：全屏无触摸（验证透传）" />
                <TextView android:id="@+id/btn_full_test"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/cp_btn_primary_text"
                    android:textSize="14sp"
                    android:text="实验 B：全屏可触摸（对照）" />
                <TextView android:id="@+id/btn_close_test"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/cp_btn_primary_text"
                    android:textSize="14sp"
                    android:text="关闭测试窗口" />
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="青色：全屏画布；黄色：图片矩形；红色：非透明像素外接矩形。A 不能拖动；B 可拖动但可能吞触摸；C 可拖动且画布外应透传。测试后回本页关闭窗口。"
                    android:textColor="@color/cp_sub"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
