<?xml version="1.0" encoding="utf-8"?>
<!-- 开关类阈值项：直接复用设置页的 SettingsSwitchRow 样式，与设置页开关行完全一致 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsSwitchRow"
    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_label"
            style="@style/SettingsOptionTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/tv_default"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="默认" android:textSize="11sp" android:textColor="@color/cp_note"
        android:layout_marginEnd="4dp"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="0dp" android:minHeight="0dp"
        android:paddingStart="6dp" android:paddingEnd="6dp" android:checked="false"/>
</LinearLayout>
