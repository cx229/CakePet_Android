<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="像素级点击测试 / Region 穿透验证"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="底部左=被测弹窗按钮(验证穿透)；右=开启全局可拖探头(屏幕右上)"
            android:textSize="12sp" />

        <!-- 区块：本地普通 View 二分测试 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一、本地普通 View（二分命中测试）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fl_normal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="#EEEEEE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_force_hit_true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="强制命中"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_force_hit_false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="强制穿透"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_force_hit_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="恢复像素"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_force_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="当前：恢复像素判定(null)"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 区块：Region 穿透方案 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="二、悬浮探头 Region 方案（setTouchableRegion）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_region_pixel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="像素级 Region（真实轮廓）" />

            <Button
                android:id="@+id/btn_region_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="25矩形 Region（5x5网格）" />

            <Button
                android:id="@+id/btn_region_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="关闭 Region（整窗拦截，对照）" />

            <TextView
                android:id="@+id/tv_region_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="当前：整窗拦截(关闭)"
                android:textSize="12sp" />



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="红框=视图边界；外框绿=命中消费；内框蓝=DOWN绿=MOVE黄=UP"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 区块：悬浮窗控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="三、悬浮窗控制"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_add_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="右下开启悬浮探头" />

            <Button
                android:id="@+id/btn_remove_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="移除悬浮探头" />
        </LinearLayout>

        <!-- 底部：穿透验证 + 开启探头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_probe_target"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="左侧被测按钮(点我弹窗)" />

            <Button
                android:id="@+id/btn_add_overlay_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="右下开启悬浮探头"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
