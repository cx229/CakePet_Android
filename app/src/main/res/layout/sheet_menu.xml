<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/menu_pat" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:text="摸摸头 🐾" android:textSize="17sp"/>
    <TextView android:id="@+id/menu_jump" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:text="跳一下" android:textSize="17sp"/>
    <TextView android:id="@+id/menu_settings" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:text="设置" android:textSize="17sp"/>
    <TextView android:id="@+id/menu_hide" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:text="隐藏宠物" android:textSize="17sp"/>
    <TextView android:id="@+id/menu_exit" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:text="退出" android:textSize="17sp"
        android:textColor="#B00020"/>
</LinearLayout>
