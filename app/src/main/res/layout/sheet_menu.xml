<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/menu_pat" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:layout_margin="4dp" android:paddingStart="12dp"
        android:text="摸摸头 🐾" android:textSize="17dp" android:textColor="@color/cp_title"
        android:background="@drawable/cell_bg"/>

    <TextView android:id="@+id/menu_actions" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center_vertical"
        android:layout_margin="4dp" android:paddingStart="12dp"
        android:text="动作 ›" android:textSize="17dp" android:textColor="@color/cp_title"
        android:background="@drawable/cell_bg"/>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <LinearLayout android:id="@+id/menu_switch_clickthrough" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="4dp" android:orientation="vertical"
            android:gravity="center_horizontal" android:padding="10dp"
            android:background="@drawable/cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="点击穿透" android:textSize="15dp" android:textColor="@color/cp_title"/>
            <Switch android:id="@+id/sw_clickthrough" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:thumbTint="@color/switch_black_selector"
                android:trackTint="@color/switch_black_selector"
                android:clickable="false" android:focusable="false"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menu_switch_gravity" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="4dp" android:orientation="vertical"
            android:gravity="center_horizontal" android:padding="10dp"
            android:background="@drawable/cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="重力抛掷" android:textSize="15dp" android:textColor="@color/cp_title"/>
            <Switch android:id="@+id/sw_gravity" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:thumbTint="@color/switch_black_selector"
                android:trackTint="@color/switch_black_selector"
                android:clickable="false" android:focusable="false"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/menu_switch_tilt" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_margin="4dp" android:orientation="vertical"
            android:gravity="center_horizontal" android:padding="10dp"
            android:background="@drawable/cell_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="体感重力" android:textSize="15dp" android:textColor="@color/cp_title"/>
            <Switch android:id="@+id/sw_tilt" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:thumbTint="@color/switch_black_selector"
                android:trackTint="@color/switch_black_selector"
                android:clickable="false" android:focusable="false"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/menu_recall" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:gravity="center"             android:text="召回"
            android:textSize="17dp" android:textColor="@color/cp_title" android:background="@drawable/cell_bg"/>
        <TextView android:id="@+id/menu_hide" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:gravity="center" android:text="隐藏"
            android:textSize="17dp" android:textColor="@color/cp_title" android:background="@drawable/cell_bg"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/menu_settings" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:gravity="center"             android:text="设置"
            android:textSize="17dp" android:textColor="@color/cp_title" android:background="@drawable/cell_bg"/>
        <TextView android:id="@+id/menu_exit" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:gravity="center" android:text="退出"
            android:textColor="@color/cp_danger" android:textSize="17dp"
            android:background="@drawable/cell_bg"/>
    </LinearLayout>

</LinearLayout>
