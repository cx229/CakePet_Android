<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg">

    <!-- 状态栏占位条：与设置页一致，高度由 Activity 按真实状态栏高度设置，与顶栏连成整体覆盖状态栏 -->
    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <!-- 顶栏：与设置页 title_bar 同高同底色，仅保留右侧三点按钮（首页无返回/标题，CakePet 不算标题） -->
    <LinearLayout android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/btn_menu"
            android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/cp_title"
            android:padding="12dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="更多"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- 内容区：与设置页一致 16dp 内边距 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/cp_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="36dp"
            android:textStyle="bold"
            android:textColor="@color/cp_title" />

        <TextView
            android:id="@+id/tv_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="初心丶CX"
            android:textSize="12dp"
            android:textColor="@color/cp_hint_dark"
            android:gravity="center" />

        <!-- 首页独立加号入口：44dp 高，主符号为普通文字 +，
             6sp 副标题恢复；子文本无上下内外边距与额外字体留白。 -->
        <LinearLayout
            android:id="@+id/btn_add_role"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="添加角色">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="+"
                android:textSize="22sp"
                android:textStyle="normal"
                android:textColor="@color/cp_btn_outline_text"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="创建/导入角色"
                android:textSize="6sp"
                android:textColor="@color/cp_note"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/role_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
