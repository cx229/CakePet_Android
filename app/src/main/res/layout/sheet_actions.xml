<?xml version="1.0" encoding="utf-8"?>
<!-- 动作子页面：上方返回，下方容器由 PetMenu 按【本角色 menuPool】动态填充（三列网格）。
     菜单项数量与内容随角色而异（如芝麻酥 12 项、蜂蜜猫 6 项），故不在布局里写死按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/act_back" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:text="‹ 返回" android:textSize="15dp" android:textColor="@color/cp_sub"/>

    <!-- 动作项容器：每行三列，由代码按 menuPool 逐项添加 -->
    <LinearLayout android:id="@+id/act_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"/>

</LinearLayout>
