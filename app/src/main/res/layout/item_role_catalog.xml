<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_btn_outline"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <!-- 行：预览图 + 名称 + 更多操作 + 加入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/role_thumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_thumb_border"
            android:clipToOutline="true"
            android:padding="4dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <!-- 标题行：名称 + 已加入数量（小号灰字，实时更新）。数量底部对齐左侧标题。 -->
            <LinearLayout
                android:id="@+id/role_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <!-- Wrap short names tightly. Code caps the maximum width using
                     the available space after reserving the count label. -->
                <TextView
                    android:id="@+id/role_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/cp_title" />

                <TextView
                    android:id="@+id/role_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:gravity="bottom"
                    android:textSize="11sp"
                    android:textColor="@color/cp_note"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 作者列表：小号灰字署名，无作者时隐藏。 -->
            <TextView
                android:id="@+id/role_authors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/cp_note"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/btn_role_options"
            android:layout_width="40dp" android:layout_height="48dp"
            android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:text="⋮" android:textSize="24sp" android:textColor="@color/cp_title"
            android:contentDescription="素材包操作" />

    </LinearLayout>
</LinearLayout>
