<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 左上角返回（与动作/交互子页一致，纯文本无按钮样式） -->
    <TextView android:id="@+id/exit_back" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="‹ 返回"
        android:textSize="16dp" android:textColor="@color/cp_title"
        android:padding="4dp" android:layout_marginBottom="4dp"/>

    <!-- 标题（居中） -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="退出" android:textSize="19dp"
        android:textColor="@color/cp_title" android:layout_marginTop="8dp"/>

    <!-- 提示（居中） -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="要退出CakePet吗？"
        android:textSize="15dp" android:textColor="@color/cp_sub" android:layout_marginTop="8dp"/>

    <!-- 一行：取消（左） / 退出（右，与宠物浮窗退出同色） -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/exit_cancel" android:layout_width="0dp"
            android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:layout_margin="4dp"
            android:text="取消" android:textSize="17dp" android:textColor="@color/cp_title"
            android:background="@drawable/cell_bg"/>
        <TextView android:id="@+id/exit_confirm" android:layout_width="0dp"
            android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:layout_margin="4dp"
            android:text="退出" android:textSize="17dp" android:textColor="@color/cp_danger"
            android:background="@drawable/cell_bg"/>
    </LinearLayout>

</LinearLayout>
