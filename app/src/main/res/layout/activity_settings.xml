<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <!-- 状态栏占位条：纯黑，高度由 Activity 按真实状态栏高度设置，与标题栏连成整体覆盖状态栏 -->
    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <!-- 标题栏：黑底，紧跟占位条之下，标题文字在状态栏下方完整显示 -->
    <LinearLayout android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">

        <ImageView android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/cp_title"
            android:padding="14dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="返回"/>

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/cp_title"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/btn_more"
            android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/cp_title"
            android:padding="12dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="更多"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        android:scrollbarFadeDuration="0"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== 模块1：显示 ===== -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="显示" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">

                <!-- 大小（新布局测试：上(左标题+数值,右滑块) 下(备注)） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="top">
                        <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="大小" style="@style/SettingsOptionTitle"/>
                            <EditText android:id="@+id/scale_value" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:text="1.40×"
                                android:textSize="16dp" android:background="@drawable/edit_bg"
                                android:inputType="numberDecimal" android:imeOptions="actionDone"
                                android:importantForAutofill="no" android:singleLine="true"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/scale_bar" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:valueFrom="0.0" android:valueTo="10.0" android:stepSize="1.0"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="「芝麻酥」可大可大可大"
                        style="@style/SettingsOptionNote" android:layout_marginBottom="4dp"/>
                </LinearLayout>

                <!-- 透明度（左标题+数值竖排，右滑块） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="透明度" style="@style/SettingsOptionTitle"/>
                        <EditText android:id="@+id/alpha_value" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="70%"
                            android:textSize="16dp" android:background="@drawable/edit_bg"
                            android:inputType="number" android:imeOptions="actionDone"
                            android:importantForAutofill="no" android:singleLine="true"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/alpha_bar" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:valueFrom="0.0" android:valueTo="100.0" android:stepSize="1.0"/>
                </LinearLayout>

                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示 / 隐藏" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_visible" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="点击穿透" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="开启后，宠物将不可被点击"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_click_through" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 显示-其他：跳转二级页（边界偏移 / 键盘适应） -->
                <LinearLayout android:id="@+id/row_range_settings"
                    style="@style/SettingsSwitchRow"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示-其他" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示范围、键盘适应"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>

                </LinearLayout>

            <!-- ===== 模块2：移动 ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="移动" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">

                <!-- 最大速度 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="最大速度" style="@style/SettingsOptionTitle"/>
                        <EditText android:id="@+id/maxspeed_value" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="5000" android:textSize="16dp"
                            android:background="@drawable/edit_bg" android:inputType="number"
                            android:imeOptions="actionDone" android:importantForAutofill="no" android:singleLine="true"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/maxspeed_bar" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:valueFrom="0.0" android:valueTo="100.0" android:stepSize="1.0"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块3：重力 ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="重力" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">

                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="重力抛掷" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="关闭后拖动即静止，不受拖动速度与重力影响"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_gravity_enabled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 体感重力（倾斜重力）-->
                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="体感重力" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="根据手机倾斜方向和角度决定重力强度和方向"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_tilt_gravity" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 重力强度 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="重力强度" style="@style/SettingsOptionTitle"/>
                        <EditText android:id="@+id/gravity_value" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="3000" android:textSize="16dp"
                            android:background="@drawable/edit_bg" android:inputType="numberDecimal"
                            android:imeOptions="actionDone" android:importantForAutofill="no" android:singleLine="true"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/gravity_bar" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:valueFrom="0.0" android:valueTo="100.0" android:stepSize="1.0"/>
                </LinearLayout>

                <!-- 四边重力：一行四个，各单元方向文字与开关水平绑定 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="四边重力" style="@style/SettingsOptionTitle"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp" android:layout_marginBottom="0dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/SettingsOptionNote"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:text="默认的重力方向，上下互斥，左右互斥"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_marginTop="2dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="上" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_top" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="下" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_bottom" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="左" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_left" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="右" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_right" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块4：反弹 ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="反弹" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">

                <!-- 反弹总开关：关闭后所有碰撞反弹失效（撞墙停靠、不反弹、不振动），四边弹力与反弹系数均不生效 -->
                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="边缘反弹" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="「芝麻酥」撞墙会反弹"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_rebound_enabled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout style="@style/SettingsSwitchRow"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="反弹振动" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="边界反弹时轻微振动"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_bounce_vibrate" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 反弹系数 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                    <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="反弹系数" style="@style/SettingsOptionTitle"/>
                        <EditText android:id="@+id/rebound_value" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="0.70" android:textSize="16dp"
                            android:background="@drawable/edit_bg" android:inputType="numberDecimal"
                            android:imeOptions="actionDone" android:importantForAutofill="no" android:singleLine="true"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/rebound_bar" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:valueFrom="0.0" android:valueTo="100.0" android:stepSize="1.0"/>
                </LinearLayout>

                <!-- 四边弹力：一行四个，各单元方向文字与开关水平绑定 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="四边弹力" style="@style/SettingsOptionTitle"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_marginTop="4dp" android:layout_marginBottom="0dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    style="@style/SettingsOptionNote"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:text="触碰边界时候触发反弹"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                    android:layout_marginTop="2dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="上" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_rtop" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="下" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_rbottom" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="左" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_rleft" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="horizontal"
                        android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp"
                        android:background="@drawable/bg_cell_gray" android:layout_margin="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="右" style="@style/SettingsOptionSub"/>
                        <Switch android:id="@+id/sw_rright" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块：贴边边（吸附边缘总开关入口 + 四边吸附 + 距离） ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="贴边边" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">

                <!-- 吸附边缘 总开关入口 -->
                <LinearLayout android:id="@+id/row_snap_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="吸附边缘" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="贴边停靠时「芝麻酥」自动吸附到边缘"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_snap_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已开启" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ===== 模块：碎碎念（开关入口，点击进入设置页） ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="碎碎念" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <LinearLayout android:id="@+id/row_thinking_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="底部消息" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="屏幕底部显示「芝麻酥」的碎碎念"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_thinking_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已关闭" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块：变变变（随机模式开关入口） ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="6dp">
                <View android:layout_width="0dp" android:layout_height="1px"
                    android:layout_weight="0.9" android:background="@color/cp_subtle"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="变变变" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <LinearLayout android:id="@+id/row_random_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="随机模式" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="「芝麻酥」的行为会偷偷改变"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_random_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已关闭" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 按钮（模块外，每个一行） ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="16dp">
                <TextView android:id="@+id/btn_about"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/bg_btn_primary" android:gravity="center"
                    android:textSize="14dp" android:textColor="@color/cp_btn_primary_text"
                    android:text="关于"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
