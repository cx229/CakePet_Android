<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <!-- 状态栏占位条：纯黑，高度由 Activity 按真实状态栏高度设置，与标题栏连成整体覆盖状态栏 -->
    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <!-- 标题栏：黑底，紧跟占位条之下，标题文字在状态栏下方完整显示 -->
    <LinearLayout android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">

        <ImageView android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/cp_title"
            android:padding="14dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="返回"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/cp_title" />

            <TextView android:id="@+id/tv_title_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/cp_hint_dark" />
        </LinearLayout>

        <ImageView android:id="@+id/btn_more"
            android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/cp_title"
            android:padding="12dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="更多"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        android:scrollbarFadeDuration="0"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== 模块1：显示 ===== -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="显示" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">

                <!-- 大小（输入框在右，滑块满宽居下） -->
                <LinearLayout android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 顶行：左标题+备注(占满) / 右数值输入框 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="大小" style="@style/SettingsOptionTitle"/>
                            <TextView android:id="@+id/note_scale" android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="「芝麻酥」可大可大可大"
                                style="@style/SettingsOptionNote"/>
                        </LinearLayout>
                        <EditText android:id="@+id/scale_value" android:layout_width="72dp"
                            android:layout_height="wrap_content" android:text="1.40×"
                            android:textSize="16dp" android:background="@drawable/edit_bg"
                            android:inputType="numberDecimal" android:imeOptions="actionDone"
                            android:importantForAutofill="no" android:singleLine="true"
                            android:gravity="center" android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <!-- 底行：满宽滑块（细、小、长）。轨道高 3dp、滑块头半径 4dp(直径8dp) -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/scale_bar" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0" android:valueTo="10.0" android:stepSize="1.0"
                        app:trackHeight="2dp" app:thumbRadius="5dp"
                        android:layout_marginTop="0dp"/>
                </LinearLayout>

                <!-- 透明度（输入框在右，滑块满宽居下） -->
                <LinearLayout android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 顶行：左标题(占满) / 右数值输入框 -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="透明度" style="@style/SettingsOptionTitle"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="「酥」的可见程度"
                                style="@style/SettingsOptionNote"/>
                        </LinearLayout>
                        <EditText android:id="@+id/alpha_value" android:layout_width="72dp"
                            android:layout_height="wrap_content" android:text="70%"
                            android:textSize="16dp" android:background="@drawable/edit_bg"
                            android:inputType="number" android:imeOptions="actionDone"
                            android:importantForAutofill="no" android:singleLine="true"
                            android:gravity="center" android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <!-- 底行：满宽滑块（细、小、长） -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/alpha_bar" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0" android:valueTo="100.0" android:stepSize="1.0"
                        app:trackHeight="2dp" app:thumbRadius="5dp"
                        android:layout_marginTop="0dp"/>
                </LinearLayout>

                <LinearLayout android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" style="@style/SettingsSwitchRow">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示 / 隐藏" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_visible" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
                </LinearLayout>

                <LinearLayout android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp" style="@style/SettingsSwitchRow">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="点击穿透" style="@style/SettingsOptionTitle"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="开启后，宠物将不可被点击"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_click_through" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
                </LinearLayout>

                <!-- 显示-其他：跳转二级页（边界偏移 / 键盘适应） -->
                <LinearLayout android:id="@+id/row_range_settings"
                    style="@style/SettingsSwitchRow"
                    android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示-其他" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="显示范围、键盘适应"
                            style="@style/SettingsOptionNote"/>
                    </LinearLayout>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>

                </LinearLayout>

            <!-- ===== 模块2：动动动 ===== -->
            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="动动动" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">

                <!-- 移动 总入口：进入阈值等详情设置页 -->
                <LinearLayout android:id="@+id/row_movement"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="移动" style="@style/SettingsOptionTitle"/>
                        <TextView android:id="@+id/note_move" android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="「酥」的运动行为轨迹学"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_move_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已开启" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>


            </LinearLayout>





            <!-- ===== 模块：贴边边（吸附边缘总开关入口 + 四边吸附 + 距离） ===== -->
            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="贴边边" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">

                <!-- 吸附边缘 总开关入口 -->
                <LinearLayout android:id="@+id/row_snap_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="吸附边缘" style="@style/SettingsOptionTitle"/>
                        <TextView android:id="@+id/note_snap" android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="贴边停靠时「芝麻酥」自动吸附到边缘"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_snap_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已开启" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ===== 模块：碎碎念（开关入口，点击进入设置页） ===== -->
            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="碎碎念" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:id="@+id/row_thinking_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="底部消息" style="@style/SettingsOptionTitle"/>
                        <TextView android:id="@+id/note_thinking" android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="屏幕底部显示「芝麻酥」的碎碎念"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_thinking_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已关闭" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块：吃吃吃（投食入口） ===== -->
            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="吃吃吃" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:id="@+id/row_feeding_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="投食" style="@style/SettingsOptionTitle"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="随机刷新掉落「支鱼」"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_feeding_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已开启" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 模块：变变变（随机模式开关入口） ===== -->
            <View android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="变变变" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:dividerPadding="16dp"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:id="@+id/row_random_mode"
                    style="@style/SettingsSwitchRow" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="随机模式" style="@style/SettingsOptionTitle"/>
                        <TextView android:id="@+id/note_random" android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/SettingsOptionNote"
                            android:text="「芝麻酥」的行为会偷偷改变"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_random_state"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="已关闭" android:textSize="14dp" android:textColor="@color/cp_note"
                        android:layout_marginEnd="10dp"
                        android:clickable="false" android:focusable="false"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_chevron"
                        android:layout_marginStart="12dp"
                        android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 按钮（模块外，每个一行） ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="16dp">
                <TextView android:id="@+id/btn_debug"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/bg_btn_primary" android:gravity="center"
                    android:textSize="14dp" android:textColor="@color/cp_btn_primary_text"
                    android:text="调试"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
