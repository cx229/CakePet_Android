<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_bg"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <!-- 状态栏占位条：纯黑，高度由 Activity 按真实状态栏高度设置，与标题栏连成整体覆盖状态栏 -->
    <View android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cp_status_bar" />

    <!-- 标题栏：黑底，紧跟占位条之下，与设置页完全一致，仅文本不同 -->
    <LinearLayout android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cp_bg">

        <ImageView android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/cp_title"
            android:padding="14dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示-适应"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/cp_title" />

            <TextView android:id="@+id/tv_title_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/cp_hint_dark" />
        </LinearLayout>

        <ImageView android:id="@+id/btn_more"
            android:layout_width="48dp" android:layout_height="48dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/cp_title"
            android:padding="12dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="更多"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        android:scrollbarFadeDuration="0"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="键盘适应" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginTop="0dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <com.cx.cakepet.SettingsRippleRow android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="键盘适应" style="@style/SettingsOptionTitle"/>
                        <TextView android:text="键盘弹出时的桌宠行为" style="@style/SettingsOptionNote" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <Spinner android:id="@+id/spinner_keyboard_mode" android:layout_width="172dp" android:layout_height="48dp"/>
                </com.cx.cakepet.SettingsRippleRow>
                <!-- 重置边界（键盘适应）：开启后键盘弹出时无视上下边界偏移，仅用键盘高度+抬高偏移 -->
                <com.cx.cakepet.SettingsRippleRow style="@style/SettingsSwitchRow" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout style="@style/SettingsSwitchTexts">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="重置边界" style="@style/SettingsOptionTitle"
                            android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="无效上下边界偏移，防触抬高位置仅基于键盘顶部"
                            style="@style/SettingsOptionNote" />
                    </LinearLayout>
                    <Switch android:id="@+id/sw_ime_reset_bottom" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:thumbTint="@color/switch_black_selector" android:trackTint="@color/switch_black_selector"/>
                </com.cx.cakepet.SettingsRippleRow>

                <!-- 抬高偏移 -->
                <com.cx.cakepet.SettingsRippleRow android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="抬高偏移" style="@style/SettingsOptionTitle"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="对「芝麻酥」抬高的高度再额外修正"
                                style="@style/SettingsOptionNote"/>
                        </LinearLayout>
                        <EditText android:id="@+id/ime_lift_value" android:layout_width="72dp"
                                android:layout_height="wrap_content" android:text="0" android:textSize="16dp"
                                android:background="@drawable/edit_bg" android:inputType="numberSigned"
                                android:imeOptions="actionDone" android:importantForAutofill="no" android:singleLine="true" android:gravity="center" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                            android:id="@+id/ime_lift_bar" android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="-800" android:valueTo="800" android:stepSize="1" app:trackHeight="2dp" app:thumbRadius="5dp" android:layout_marginTop="0dp"/>
                </com.cx.cakepet.SettingsRippleRow>


            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="旋转适应" android:textSize="14dp" android:textColor="@color/cp_sub"
                android:layout_marginStart="4dp" android:layout_marginTop="24dp" android:layout_marginBottom="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:divider="@drawable/item_divider" android:showDividers="middle"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <com.cx.cakepet.SettingsRippleRow android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="旋转适应" style="@style/SettingsOptionTitle"/>
                    </LinearLayout>
                    <Spinner android:id="@+id/spinner_rotation_mode" android:layout_width="172dp" android:layout_height="48dp"/>
                </com.cx.cakepet.SettingsRippleRow>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
