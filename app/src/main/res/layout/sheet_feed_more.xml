<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedmore_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 左上角返回 -->
    <TextView android:id="@+id/fdm_back" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:text="‹ 返回" android:textSize="15dp" android:textColor="@color/cp_sub"/>

    <!-- 第一行：投食 -->
    <TextView android:id="@+id/feed_now" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center"
        android:layout_margin="4dp"
        android:text="投食" android:textSize="17dp" android:textColor="@color/cp_title"
        android:background="@drawable/cell_bg"/>

    <!-- 第二行：重置大小 -->
    <TextView android:id="@+id/reset_size" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center"
        android:layout_margin="4dp"
        android:text="重置大小" android:textSize="17dp" android:textColor="@color/cp_title"
        android:background="@drawable/cell_bg"/>

    <!-- 第三行：投食-归位 + 投食-清空（全部鱼重置位置/清除所有） -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_margin="4dp">
        <TextView android:id="@+id/feed_reset" android:layout_width="0dp"
            android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:layout_marginEnd="4dp"
            android:text="投食-归位" android:textSize="16dp" android:textColor="@color/cp_title"
            android:background="@drawable/cell_bg"/>
        <TextView android:id="@+id/feed_clear" android:layout_width="0dp"
            android:layout_height="56dp" android:layout_weight="1" android:gravity="center"
            android:layout_marginStart="4dp"
            android:text="投食-清空" android:textSize="16dp" android:textColor="@color/cp_title"
            android:background="@drawable/cell_bg"/>
    </LinearLayout>

    <!-- 第四行：投食-刷新（开关：投食随机掉落） -->
    <LinearLayout android:id="@+id/menu_switch_feedrefresh" android:layout_width="match_parent"
        android:layout_height="56dp" android:orientation="horizontal"
        android:gravity="center" android:background="@drawable/cell_bg"
        android:layout_margin="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="投食-刷新" android:textSize="16dp" android:textColor="@color/cp_title"/>
        <Switch android:id="@+id/sw_feedrefresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/switch_black_selector"
            android:trackTint="@color/switch_black_selector"
            android:clickable="false" android:focusable="false"/>
    </LinearLayout>

    <!-- 第五行：投食-设置（打开投食设置页） -->
    <TextView android:id="@+id/fdm_settings" android:layout_width="match_parent"
        android:layout_height="56dp" android:gravity="center"
        android:layout_margin="4dp"
        android:text="投食-设置" android:textSize="17dp" android:textColor="@color/cp_title"
        android:background="@drawable/cell_bg"/>

</LinearLayout>
