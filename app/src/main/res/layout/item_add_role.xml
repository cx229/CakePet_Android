<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:layout_marginBottom="12dp" android:orientation="vertical"
    android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp"
    android:clickable="true" android:focusable="true"
    android:background="@drawable/bg_btn_outline">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:includeFontPadding="false" android:paddingTop="0dp" android:paddingBottom="0dp"
        android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="+"
        android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/cp_btn_outline_text" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:includeFontPadding="false" android:layout_marginTop="0dp"
        android:text="创建/导入角色" android:textSize="8sp"
        android:textColor="@color/cp_note" />
</LinearLayout>
