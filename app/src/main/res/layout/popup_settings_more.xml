<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_bg_popup"
    android:padding="4dp">

    <TextView
        android:id="@+id/item_threshold"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="默认值与阈值"
        android:textSize="11sp"
        android:textColor="@color/cp_title"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cp_subtle" />

    <TextView
        android:id="@+id/item_settings_import"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="导入角色设置"
        android:textSize="11sp"
        android:textColor="@color/cp_title"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/item_settings_export"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="导出角色设置"
        android:textSize="11sp"
        android:textColor="@color/cp_title"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cp_subtle" />

    <TextView
        android:id="@+id/item_rename"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="重命名角色"
        android:textSize="11sp"
        android:textColor="@color/cp_title"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/item_edit_material"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="编辑所属素材包"
        android:textSize="11sp"
        android:textColor="@color/cp_title"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cp_subtle" />

    <TextView
        android:id="@+id/item_reset_all"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="重置角色"
        android:textSize="11sp"
        android:textColor="@color/cp_danger"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cp_subtle" />

    <TextView
        android:id="@+id/item_delete"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="删除角色"
        android:textSize="11sp"
        android:textColor="@color/cp_danger"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>
