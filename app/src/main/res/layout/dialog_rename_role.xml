<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="420dp"
        app:cardBackgroundColor="@color/cp_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:contentPadding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cp_title"
                tools:text="角色重命名" />
            <ImageView
                android:id="@+id/btn_close_x"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_dialog_close"
                android:tint="@color/cp_sub"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="角色名称"
            android:textSize="12sp"
            android:textColor="@color/cp_sub" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="text"
            android:hint="如：芝麻酥"
            android:textSize="15sp"
            android:textColor="@color/cp_text"
            android:textColorHint="@color/cp_sub"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="角色简称"
            android:textSize="12sp"
            android:textColor="@color/cp_sub" />

        <EditText
            android:id="@+id/et_short"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="text"
            android:hint="酥"
            android:textSize="15sp"
            android:textColor="@color/cp_text"
            android:textColorHint="@color/cp_sub"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_negative"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:textColor="@color/cp_btn_outline_text"
                app:strokeColor="@color/cp_btn_outline_stroke"
                app:backgroundTint="@android:color/transparent"
                android:text="取消" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_positive"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="72dp"
                android:textColor="@color/cp_btn_primary_text"
                app:backgroundTint="@color/cp_btn_primary_bg"
                android:text="保存" />
        </LinearLayout>
    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
