<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/menu_bg_popup"
    android:padding="4dp">
    <TextView android:id="@+id/item_habit_import" android:layout_width="200dp"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:text="导入用户习惯" android:textSize="11sp"
        android:textColor="@color/cp_title" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/item_habit_export" android:layout_width="200dp"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:text="导出用户习惯" android:textSize="11sp"
        android:textColor="@color/cp_title" android:background="?attr/selectableItemBackground"/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/cp_subtle"/>
    <TextView android:id="@+id/item_habit_apply_all" android:layout_width="200dp"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:text="全部应用到已有角色" android:textSize="11sp"
        android:textColor="@color/cp_title" android:background="?attr/selectableItemBackground"/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/cp_subtle"/>
    <TextView android:id="@+id/item_habit_reset" android:layout_width="200dp"
        android:layout_height="48dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:text="恢复初始用户习惯" android:textSize="11sp"
        android:textColor="@color/cp_danger" android:background="?attr/selectableItemBackground"/>
</LinearLayout>
