<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CakePet" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/switch_on_night</item>
        <item name="colorSecondaryVariant">@color/switch_on_night</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- ===== 夜间开关：未显式设置 tint 的 Switch 也使用个性化设置页的浅色开启态。 ===== -->
        <item name="colorSecondary">@color/switch_on_night</item>
        <item name="colorSecondaryVariant">@color/switch_on_night</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/switch_on_night</item>
        <item name="colorSwitchThumbNormal">#9AA0A6</item>
        <item name="android:colorForeground">@color/cp_text</item>
        <!-- SwitchCompat 优先使用现有昼夜选择器配色 -->
        <item name="switchStyle">@style/Widget.CakePet.Switch</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 设置页/调试页（无 ActionBar）夜间配色：开关/滑块改用浅色强调色 -->
    <style name="Theme.CakePet.FullscreenTitle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorSecondary">@color/switch_on_night</item>
        <item name="colorSecondaryVariant">@color/switch_on_night</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/switch_on_night</item>
        <item name="colorSwitchThumbNormal">#9AA0A6</item>
        <item name="android:colorForeground">@color/cp_text</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="switchStyle">@style/Widget.CakePet.Switch</item>
    </style>

    <!-- 透明主题（长按菜单）夜间配色：开关使用浅色开启态 -->
    <style name="Theme.CakePet.Transparent" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorSecondary">@color/switch_on_night</item>
        <item name="colorSecondaryVariant">@color/switch_on_night</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/switch_on_night</item>
        <item name="colorSwitchThumbNormal">#9AA0A6</item>
        <item name="android:colorForeground">@color/cp_text</item>
        <item name="switchStyle">@style/Widget.CakePet.Switch</item>
    </style>
</resources>