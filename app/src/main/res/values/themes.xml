<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CakePet" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <!-- MaterialComponents 主题下 Switch 的开启色由 colorSecondary 控制（非 colorControlActivated），
             故置纯黑让所有开关（菜单/关于/设置）开启态均为黑色。 -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Switch / 开关黑色系（纯黑）：开启态滑块与轨道高亮为纯黑 -->
        <item name="colorControlActivated">@color/black</item>
        <item name="colorSwitchThumbNormal">@color/switch_off_thumb</item>
        <item name="android:colorForeground">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 设置页/关于页专用：无 ActionBar。状态栏不透明（黑色），标题栏上方由布局放一个
         高度=状态栏高度的纯黑占位条，与标题栏黑底连成整体覆盖状态栏；
         标题文字在标题栏内完整显示，不与状态栏时间/电量重叠。不使用透明/translucent 黑魔法。 -->
    <style name="Theme.CakePet.FullscreenTitle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorSwitchThumbNormal">@color/switch_off_thumb</item>
        <item name="android:colorForeground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>

    <!-- 透明主题：用于长按菜单 Activity，仅显示 BottomSheet -->
    <style name="Theme.CakePet.Transparent" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <!-- Switch / 开关黑色系（纯黑）：Material 下开启色由 colorSecondary 控制 -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorSwitchThumbNormal">@color/switch_off_thumb</item>
        <item name="android:colorForeground">@color/black</item>
    </style>
</resources>