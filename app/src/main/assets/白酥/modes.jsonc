  "thinkingGroups": ["日常", "提起", "落地", "摸头", "高兴"],
  "thinkings": {
    "t001": {"text": "你盯着屏幕，而我盯着你，谁又在盯着我们呢？", "groups": ["日常"]},
    "t002": {"text": "存在大于本质，但小鱼干先大于一切", "groups": ["日常"]},
    "t003": {"text": "我是谁？我从哪里来？要到哪里去？", "groups": ["日常"]},
    "t004": {"text": "喵生三大事：吃饭，睡觉", "groups": ["日常"]},
    "t005": {"text": "如果桌面是无限的，它的尽头在哪里？", "groups": ["日常"]},
    "t006": {"text": "今天想通了一个道理，有些道理是想不通的", "groups": ["日常"]},
    "t007": {"text": "（此处应有哲学）", "groups": ["日常"]},
    "t008": {"text": "我刚刚想到了一个绝妙的计划，但现在已经忘了", "groups": ["日常"]},
    "t009": {"text": "我决定把今天剩下的时间都用来发呆，这是经过深思熟虑的", "groups": ["日常"]},
    "t010": {"text": "你忙你的，我……我也忙我的", "groups": ["日常"]},
    "t011": {"text": "为什么圆的总是比方的更值得拍？", "groups": ["日常"]},
    "t012": {"text": "闭上眼睛的时候，耳朵就变得特别忙", "groups": ["日常"]},
    "t013": {"text": "我决定什么都不决定", "groups": ["日常"]},
    "t014": {"text": "等。等。等。等到了。什么？", "groups": ["日常"]},
    "t015": {"text": "我刚才觉得自己是一个球，滚来滚去的那种", "groups": ["落地"]},
    "t016": {"text": "zzzZZZ...", "groups": ["日常"]},
    "t017": {"text": "喵？！？", "groups": ["日常", "落地", "提起"]},
    "t018": {"text": "喵！", "groups": ["日常"]},
    "t019": {"text": "哦呜~ 哦呜~", "groups": ["日常"]},
    "t020": {"text": "哦呜~", "groups": ["日常"]},
    "t021": {"text": "咕噜咕咕噜...", "groups": ["日常", "落地", "高兴"]},
    "t022": {"text": "呼噜……呼噜……", "groups": ["日常", "落地", "高兴"]},
    "t023": {"text": "嗯？", "groups": ["日常"]},
    "t024": {"text": "……哦。", "groups": ["日常"]},
    "t025": {"text": "咕。", "groups": ["日常"]},
    "t026": {"text": "喵呜。", "groups": ["日常"]},
    "t027": {"text": "哈——", "groups": ["日常"]},
    "t028": {"text": "咔。", "groups": ["日常"]},
    "t029": {"text": "......", "groups": ["日常"]},
    "t030": {"text": "……", "groups": ["日常"]},
    "t031": {"text": "嗯。", "groups": ["日常"]},
    "t032": {"text": "哦。", "groups": ["日常"]},
    "t033": {"text": "……？", "groups": ["日常", "落地", "提起", "摸头"]},
    "t034": {"text": "呼。", "groups": ["日常"]},
    "t035": {"text": "唔。", "groups": ["日常"]},
    "t036": {"text": "……啊。", "groups": ["日常"]},
    "t037": {"text": "(✘_✘)", "groups": ["日常", "落地", "提起"]},
    "t038": {"text": "(=°Д°=)", "groups": ["日常"]},
    "t039": {"text": "(◦`~´◦)", "groups": ["日常"]},
    "t040": {"text": "(=^‥^=)", "groups": ["日常", "摸头"]},
    "t041": {"text": "(⋟﹏⋞)", "groups": ["日常", "落地", "提起", "摸头"]},
    "t048": {"text": "……不胖……不胖……", "groups": ["日常"]},
    "t049": {"text": "我会一直看着你", "groups": ["日常"]},
    "t050": {"text": "我有驾驶证", "groups": ["日常"]},
    "p001": {"text": "喵喵喵", "groups": ["摸头", "高兴"]},
    "p002": {"text": "喵", "groups": ["摸头", "高兴"]},
    "p003": {"text": "喵！", "groups": ["摸头", "高兴"]},
    "p004": {"text": "喵？！？", "groups": ["摸头"]},
    "p005": {"text": "~o( =∩ω∩= )m", "groups": ["摸头", "高兴"]},
