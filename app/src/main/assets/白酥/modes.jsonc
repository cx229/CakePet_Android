    "l001": {"text": "喵？...", "groups": ["提起"]},
    "l002": {"text": "喵？喵？喵？", "groups": ["提起"]},
    "l003": {"text": "喵？！？", "groups": ["提起"]},
    "d001": {"text": "喵？.....", "groups": ["落地", "提起"]},
